{
  "name": "wishlisto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A cute, self-hostable wishlist app with group sharing and hidden claims.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/identicon": "9.4.2",
    "@hono/node-server": "^2.1.6",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
