# Docker Compose only: a published image to run instead of building locally.
# WISHLISTO_IMAGE=ghcr.io/OWNER/REPO:latest

# ── Core ──────────────────────────────────────────────────────────────────────
# Use production on a server.
NODE_ENV=production

# The app listens on this port inside the container (and on the host in compose).
PORT=8099
HOST=0.0.0.0

# Public origin. Used for cookie security defaults and shown in logs.
BASE_URL=https://wishlist.example.com

# One volume, one data directory: SQLite database + uploaded images live here.
DATA_DIR=./data

# Built static assets. In Docker this is /app/dist/public.
PUBLIC_DIR=./src/public

# ── Security ─────────────────────────────────────────────────────────────────
# Defaults to true when BASE_URL starts with https://. Set explicitly to false
# only for local HTTP development.
COOKIE_SECURE=true

# Set true only behind a trusted reverse proxy (Traefik, Caddy, nginx).
# It makes the app read X-Forwarded-For / X-Real-IP for rate limiting.
TRUST_PROXY=true

SESSION_TTL_DAYS=30

# Open registration. Can also be changed later in the database/app settings.
OPEN_SIGNUP=true

# ── First-run admin ──────────────────────────────────────────────────────────
# Optional. If both are set and the instance has zero users, this creates the
# single admin account on boot. Existing users are never changed by these
# variables. Leave both empty to use the /setup page instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Uploads / logging ────────────────────────────────────────────────────────
MAX_UPLOAD_MB=8
LOG_LEVEL=info

# Prefill a wish's title and description from a pasted link. Set false to make no outbound requests.
# LINK_PREVIEW_ENABLED=true

# Branding and landing copy. Edit site.json, or point this at your own file.
# SITE_CONFIG=site.json

# DiceBear avatar style for every user (default: initials). Licences are shown in Settings.
# AVATAR_STYLE=initials
